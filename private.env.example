# 复制为 private.env 并填入真实值（private.env 已被 .gitignore 排除，不会上传）
# 未设置的环境变量也走这里。全部变量均可通过进程环境变量覆盖。

# B站投稿 cookie（biliup 格式 JSON：cookie_info.cookies[] 含 SESSDATA/bili_jct/DedeUserID）
BILI_COOKIE_FILE=/path/to/biliup_cookies.json

# 两个合集锚点（B站合集内任意一个视频 BV 号），逗号分隔
COLLECTION_ANCHORS=BV13ege65Es5,BV1ZYNT6hEEe
# 合集显示名（可选，与 anchors 一一对应）
COLLECTION_NAMES=直播1,直播2

# 评论发布账号的 B站 mid（用于跳过已发布检测）
OWNER_MID=<你的B站mid>

# YouTube Data API v3（已在 WDC 实测通过；仅在 Innertube 429 后启用）
YOUTUBE_API_KEY=
# 可选：auto（默认，429 后切官方 API）或 official（始终使用官方 API）
YOUTUBE_FETCH_BACKEND=auto
# 生产 cron 会强制 cache_only；开发环境留空为 auto
YOUTUBE_FETCH_MODE=auto
# GitHub Action 请求间隔；默认 2 秒，Action workflow 使用 3 秒
YOUTUBE_REQUEST_MIN_GAP_SECONDS=2


# 飞书通知（仅允许当前项目 yt-comment-automation 机器人；不要配置旧 bridge）
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
MY_FEISHU_OPEN_ID=ou_xxx

# DRY_RUN=1 时只干跑不发布（CLI 的 run 命令会强制读此值之外的显式参数）
DRY_RUN=0
